# Copy to .env for local development. Never commit .env. On Render set these in the dashboard (Environment tab), not in a file.
GEMINI_API_KEY=your_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite
# Leave EMPTY to use in-memory storage. If set, the file must exist (on Render use a Secret File: /etc/secrets/<name>.json).
# A wrong path is now logged and falls back to in-memory storage instead of crashing the server.
FIREBASE_CREDENTIALS=
# Comma separated list of allowed frontend origins. Add your Vercel URL here when deployed, e.g. https://brandguard-ai.vercel.app
CORS_ORIGINS=http://localhost:5173
# Optional tuning (defaults shown). Lower OCR_MAX_SIDE if the server runs out of memory.
OCR_MAX_SIDE=1280
MAX_IMAGE_PIXELS=25000000
LOG_LEVEL=INFO
# Image analysis reuses GEMINI_API_KEY and GEMINI_MODEL (the model must support images, e.g. gemini-2.0-flash).
